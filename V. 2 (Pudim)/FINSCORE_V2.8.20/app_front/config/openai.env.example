# Copie estas linhas para app_front/.env. Nunca versione a chave real.
OPENAI_API_KEY=insira_sua_chave_openai_aqui
FINSCORE_LLM_MODEL=gpt-5.6-sol
FINSCORE_LLM_TEMPERATURE=0.2
FINSCORE_LLM_REASONING_EFFORT=high
FINSCORE_LLM_MAX_OUTPUT_TOKENS=12000

# Perfis autorizados a registrar deliberação de alçada (e-mails separados por vírgula).
FINSCORE_AUTHORITY_EMAILS=gestor.credito@instituicao.com
# Administradores também possuem permissão de alçada.
FINSCORE_ADMIN_EMAILS=
